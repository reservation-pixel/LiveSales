# Petpooja credentials. Copy to .env and fill in.
#
#   cp .env.example .env
#   node --env-file=.env server.mjs
#
# .env is gitignored. Never commit the real values.

# BILLING credential set — the one the Orders API uses.
PP_APP_KEY=
PP_APP_SECRET=
PP_ACCESS_TOKEN=
PP_COOKIE=

# Optional
PORT=4000
POLL_MS=60000
# How many whole months of history to backfill on first run, in addition to
# the current one. 2 gives a month view plus its previous-month comparison.
BACKFILL_MONTHS=2

# How far back the date and month pickers may reach. Months outside the
# backfill are fetched the first time they are opened, then cached.
HISTORY_MONTHS=6
